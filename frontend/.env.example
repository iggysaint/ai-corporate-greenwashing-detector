# Base URL of the FastAPI backend, as reached from the user's browser.
# Public by design (compiled into client code): never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Timeout for full ESG assessments in milliseconds (minimum 60000). First runs on large filings can take minutes.
NEXT_PUBLIC_ANALYSIS_TIMEOUT_MS=300000
